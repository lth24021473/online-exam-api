# Use a separate MongoDB database (replica set required).
DATABASE_URL=mongodb://localhost:27017/online_exam?replicaSet=rs0

PORT=3000

JWT_SECRET=
# Token lifetime in seconds (86400 = 1 day).
JWT_EXPIRES_IN=86400

# Frontend origin URL for password reset links and CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional SMTP configuration for sending real emails
# If not provided, outgoing emails (like reset tokens) are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Online Exam" <noreply@online-exam.com>

# S3 / Cloudflare R2 / MinIO Object Storage Configuration
# - MinIO (local default below): set S3_ENDPOINT and S3_PUBLIC_URL_PREFIX
# - Cloudflare R2: set S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
# - AWS S3: leave S3_ENDPOINT and S3_PUBLIC_URL_PREFIX empty/unset (or set CDN URL for S3_PUBLIC_URL_PREFIX)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=online-exam-storage
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL_PREFIX=http://localhost:9000/online-exam-storage

# Optional Redis configuration (used by readiness/health probes)
# Provide either REDIS_URL or REDIS_HOST (+ optional port, password, db).
# Leave unset if Redis is not configured (/health/ready returns 503 while /health/live stays 200).
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
