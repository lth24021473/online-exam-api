# Use a separate MongoDB database (replica set required).
DATABASE_URL=mongodb://localhost:27017/online_exam?replicaSet=rs0

PORT=3000

JWT_SECRET=
# Token lifetime in seconds (86400 = 1 day).
JWT_EXPIRES_IN=86400

# Frontend origin URL for password reset links and CORS
FRONTEND_URL=http://localhost:5173

# Optional SMTP configuration for sending real emails
# If not provided, outgoing emails (like reset tokens) are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Online Exam" <noreply@online-exam.com>
