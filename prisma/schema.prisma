generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EXAM_MANAGER
  ADMIN
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  CANCELLED
}

model RevokedToken {
  tokenHash String   @id @map("_id")
  expiresAt DateTime

  @@index([expiresAt])
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STUDENT)
  authVersion  Int?     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exams    Exam[]
  attempts Attempt[]
}

model Exam {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  instructions    String?
  durationMinutes Int
  status          ExamStatus @default(DRAFT)
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  managerId       String     @db.ObjectId
  manager         User       @relation(fields: [managerId], references: [id])
  questions       Question[]
  attempts        Attempt[]

  @@index([managerId])
  @@index([status])
}

model Question {
  id       String          @id @default(auto()) @map("_id") @db.ObjectId
  examId   String          @db.ObjectId
  exam     Exam            @relation(fields: [examId], references: [id])
  content  String
  options  Option[]
  position Int
  answers  AttemptAnswer[]

  @@unique([examId, position])
}

model Option {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  questionId String          @db.ObjectId
  question   Question        @relation(fields: [questionId], references: [id])
  content    String
  position   Int
  isCorrect  Boolean         @default(false)
  answers    AttemptAnswer[]

  @@unique([questionId, position])
}

model Attempt {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id])
  examId         String        @db.ObjectId
  exam           Exam          @relation(fields: [examId], references: [id])
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  cancelledAt    DateTime?
  answerVersion  Int           @default(0)
  score          Float?
  totalQuestions Int
  correctCount   Int?
  incorrectCount Int?
  answers        AttemptAnswer[]

  @@index([userId, startedAt])
  @@index([examId, status])
}

model AttemptAnswer {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  attemptId        String   @db.ObjectId
  attempt          Attempt  @relation(fields: [attemptId], references: [id])
  questionId       String   @db.ObjectId
  question         Question @relation(fields: [questionId], references: [id])
  selectedOptionId String   @db.ObjectId
  selectedOption   Option   @relation(fields: [selectedOptionId], references: [id])
  updatedAt        DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("Answer")
}
